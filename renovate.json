{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlertsWithLabel('security')",
    ":rebaseStalePrs",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Brussels",
  "labels": [
    "renovate"
  ],
  "platformAutomerge": false,
  "automergeType": "pr",
  "ignoreTests": false,
  "packageRules": [
    {
      "description": "Automerge Python dependency patch updates after CI",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Keep Python dependency minor and major updates manual",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Keep GitHub Actions updates manual because tagging and publishing are privileged",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": false
    },
    {
      "description": "Keep Docker base-image changes manual",
      "matchDatasources": [
        "docker"
      ],
      "automerge": false
    }
  ],
  "pinDigests": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the digest-pinned actionlint Docker image used by workflow lint",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/workflow-lint\\.yml$/"
      ],
      "matchStrings": [
        "ACTIONLINT_IMAGE: \"rhysd/actionlint:(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
